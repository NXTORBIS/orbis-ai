{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  "//": "Tests in src/shared run under Node, not in the browser: they import node:test, which the renderer's type environment has no reason to know about. They are type-checked by tsconfig.node.json instead.",
  "exclude": ["src/shared/**/*.test.ts"]
}
