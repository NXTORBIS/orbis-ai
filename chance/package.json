    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "fake-indexeddb": "6.0.0",
    "fast-check": "3.22.0",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
