{
  "name": "nxtorbis-ai",
  "productName": "Orbis",
  "version": "0.3.0",
  "description": "Orbis, a HUD-style desktop AI assistant powered by NVIDIA NIM",
  "author": "Nxtorbis",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/brand-dev-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "sign:drm": "python -m castlabs_evs.vmp sign-pkg dist/win-unpacked",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runTests.mjs",
    "stage:browser": "node --experimental-strip-types src/helper/adblock/cli.ts && node scripts/build-extension.mjs && node scripts/stage-orbis-extension.mjs && node scripts/stage-chromium.mjs",
    "dist": "npm run typecheck && npm run stage:browser && npm run notices && npm run build && electron-builder --win",
    "notices": "node scripts/generate-notices.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "d3-force": "^3.0.0",
    "electron-chrome-web-store": "0.13.0",
    "koffi": "^3.3.1",
    "onnxruntime-web": "^1.29.0"
  }
}
