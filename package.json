{
  "name": "nxtorbis-ai",
  "productName": "Orbis",
  "version": "0.3.0",
  "description": "Orbis, a HUD-style desktop AI assistant powered by NVIDIA NIM",
  "author": "Nxtorbis",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/brand-dev-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:chance",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:ui",
    "sign:drm": "python -m castlabs_evs.vmp sign-pkg dist/win-unpacked",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runTests.mjs",
    "stage:browser": "node --experimental-strip-types src/helper/adblock/cli.ts && node scripts/build-extension.mjs && node scripts/stage-orbis-extension.mjs && node scripts/stage-neterror.mjs && node scripts/stage-chromium.mjs",
    "dist": "npm run typecheck && npm run stage:browser && npm run notices && npm run build && electron-builder --win",
    "notices": "node scripts/generate-notices.mjs",
    "typecheck:ui": "tsc --noEmit -p tsconfig.orbis-ui.json",
    "css:report": "node scripts/cssReport.mjs",
    "cosmos:build": "node scripts/cosmos-build.mjs",
    "eye:install": "npm --prefix orbiseye install --no-audit --no-fund",
    "build:chance": "node chance/node_modules/vite/bin/vite.js build chance --outDir ../out/renderer/chance --emptyOutDir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.186.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "docx": "^9.8.1",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.18.2",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "7z-wasm": "^1.2.0",
    "basic-ftp": "^6.2.2",
    "bmp-js": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "diff": "^7.0.0",
    "electron-chrome-web-store": "0.13.0",
    "jspdf": "^4.2.1",
    "koffi": "^3.3.1",
    "node-pty": "^1.1.0",
    "onnxruntime-web": "^1.29.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "recharts": "^3.10.1",
    "sql.js": "^1.11.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "tar": "^7.4.3",
    "tesseract.js": "^7.0.0",
    "three": "^0.170.0",
    "yauzl": "^3.2.0",
    "yazl": "^2.5.1",
    "zod": "^3.23.8"
  }
}
