# Copy this file to .env.local and put your Groq API key after the = sign.
# Multiple keys can be listed, separated by commas:
#   GROQ_API_KEY=key1,key2,key3
# Orbis automatically rotates to the next key when one:
#   - Is rejected (revoked or invalid)
#   - Hits a rate limit (429 error)
# .env.local is git-ignored, so keys are never pushed to GitHub.
# `npm run dev` and `npm run dist` build the keys into the app: do not share builds that contain them.
GROQ_API_KEY=
