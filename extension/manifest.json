{
  "manifest_version": 3,
  "name": "Orbis",
  "version": "0.1.0",
  "description": "Orbis ad blocking and pages for the Orbis browser (a component of the browser).",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "scripting",
    "storage",
    "topSites",
    "search",
    "favicon",
    "downloads",
    "history",
    "bookmarks",
    "cookies",
    "browsingData",
    "tabGroups",
    "sessions",
    "management",
    "debugger",
    "readingList",
    "contentSettings",
    "downloads.open"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "adblock/rules/ads.json"
      },
      {
        "id": "ads-strict",
        "enabled": false,
        "path": "adblock/rules/ads-strict.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "adblock/rules/trackers.json"
      },
      {
        "id": "trackers-strict",
        "enabled": false,
        "path": "adblock/rules/trackers-strict.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "adblock/rules/annoyances.json"
      },
      {
        "id": "annoyances-strict",
        "enabled": false,
        "path": "adblock/rules/annoyances-strict.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adblock-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
