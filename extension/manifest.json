{
  "manifest_version": 3,
  "name": "Orbis",
  "version": "0.1.0",
  "description": "Orbis, beside the page: Orion, Search, memory and more, running on this computer.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Orbis"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  }
}
