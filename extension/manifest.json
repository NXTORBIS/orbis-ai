{
  "manifest_version": 3,
  "name": "Orbis",
  "version": "0.1.0",
  "description": "Orbis, beside the page: Orion, Search, memory and more, running on this computer.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "scripting",
    "storage",
    "topSites",
    "search",
    "favicon"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Orbis",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "adblock/rules/ads.json"
      },
      {
        "id": "ads-strict",
        "enabled": false,
        "path": "adblock/rules/ads-strict.json"
      },
      {
        "id": "trackers",
        "enabled": true,
        "path": "adblock/rules/trackers.json"
      },
      {
        "id": "trackers-strict",
        "enabled": false,
        "path": "adblock/rules/trackers-strict.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "adblock/rules/annoyances.json"
      },
      {
        "id": "annoyances-strict",
        "enabled": false,
        "path": "adblock/rules/annoyances-strict.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adblock-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}