# Filter lists are downloaded at runtime, never shipped: they are published under licences of their own.
resources/adblock/lists/
resources/adblock/manifest.json

# The Orbis helper writes its port and secret token here on every start. Never commit it.
extension/helper.json

# The helper's own store when it is run with --data-dir extension (scripts/run-orbis-chromium.ps1): notes, tasks,
# knowledge, whatever has been saved. It is the person's, not the repository's, and this repository is public.
extension/personal-data/

# Generated by scripts/build-extension.mjs and src/helper/adblock/cli.ts
extension/adblock.js
extension/adblock-content.js
extension/adblock/
extension/adblock.staging/
extension/adblock.previous/
extension/_metadata/
orbis-ui/results/results.js
resources/chromium/

# Backups of the browser icons taken before they were replaced. Kept on disk, not in the repository.
*.before-orbis

# Chromium user-data folders left behind by probe runs (algolab/, sorts/, organic-tabs/, physlab/, every/, cslabs/
# and their numbered siblings). Each holds a whole browser profile, Widevine binaries included. They are scratch.
algolab*/
sorts*/
organic-tabs*/
physlab*/
every*/
cslabs/
jarvis-file-list.txt

# ORBIS COSMOS: what Gradle and scripts/cosmos-build.mjs make
cosmos/.build/
cosmos/build/
cosmos/core/build/
cosmos/.gradle/

# Build leftovers, not part of the project
.ssr/
bash.exe.stackdump
