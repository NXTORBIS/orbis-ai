+// The Orbis Search engine, found or built. Null only when neither was possible.
+TemplateURL* TemplateURLService::EnsureOrbisSearchEngine() {
+  if (TemplateURL* found = FindPrepopulatedTemplateURL(9001)) {
+    return found;
   }
-  if (orbis) {
-    SetUserSelectedDefaultSearchProvider(orbis);
