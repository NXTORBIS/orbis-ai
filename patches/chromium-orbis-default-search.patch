+// Orbis: profiles made before Orbis Search became the default keep the prepopulated Google engine as their default. Once, and only
+// when the default is still that untouched prepopulated Google entry (prepopulated, not edited by the user, not set by policy or an
+// extension), switch it to Orbis Search. Any other engine the user picked (DuckDuckGo, ...) is left alone. A profile whose owner
+// deliberately chose the untouched prepopulated Google engine cannot be told apart from an old default, so it is switched too;
+// Google stays one click away in settings and by the @google keyword.
+void TemplateURLService::MaybeMigrateDefaultToOrbisSearch() {
+  constexpr char kMigratedPref[] = "orbis.default_search_migrated";
+  if (prefs_->GetBoolean(kMigratedPref)) {
+    return;
+  }
+  prefs_->SetBoolean(kMigratedPref, true);
+  if (default_search_provider_source_ != DefaultSearchManager::FROM_USER &&
+      default_search_provider_source_ != DefaultSearchManager::FROM_FALLBACK) {
+    return;
+  }
+  const TemplateURL* current = default_search_provider_;
+  if (!current || current->prepopulate_id() != 1 ||
+      !current->safe_for_autoreplace() ||
+      current->type() != TemplateURL::NORMAL) {
+    return;
+  }
+  TemplateURL* orbis = FindPrepopulatedTemplateURL(9001);
+  if (!orbis) {
+    std::unique_ptr<TemplateURLData> data =
+        prepopulate_data_resolver_->GetFallbackSearch();
+    if (!data || data->prepopulate_id != 9001) {
+      return;
+    }
+    data->id = kInvalidTemplateURLID;
+    orbis = Add(std::make_unique<TemplateURL>(*data));
+  }
+  if (orbis) {
+    SetUserSelectedDefaultSearchProvider(orbis);
+  }
+}
