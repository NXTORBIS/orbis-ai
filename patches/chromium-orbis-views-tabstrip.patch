+
+// Orbis: the active tab carries an accent bar along the bottom of its pill, so it is distinguished by shape and mark, not by
+// colour alone.
+void HorizontalTabStyleViews::PaintOrbisIndicator(gfx::Canvas* canvas) const {
+  if (!delegate_->IsActive() || delegate_->IsClosing()) {
+    return;
+  }
+  const ui::ColorProvider* cp = delegate_->GetView()->GetColorProvider();
+  if (!cp) {
+    return;
+  }
+  const SkPath pill = GetPath(TabStyle::PathType::kHighlight, canvas->image_scale(), {});
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+  const SkRect r = pill.getBounds();
+  const float thickness = orbis::size::kIndicatorThickness * scale;
+  float inset = 12 * scale;
+  if (r.width() < 2 * inset + 8 * scale) {
+    inset = 6 * scale;
+  }
+  if (r.width() < 2 * inset + 4 * scale) {
+    return;
+  }
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(cp->GetColor(ui::kColorSysPrimary));
+  canvas->sk_canvas()->drawRoundRect(
+      SkRect::MakeLTRB(r.left() + inset, r.bottom() - thickness - scale, r.right() - inset, r.bottom() - scale),
+      thickness / 2, thickness / 2, flags);
 }
 
