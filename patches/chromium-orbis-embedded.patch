+// Orbis: with --orbis-embedded, a browser window that the Orbis app has made a child of its own window is frameless: no caption
+// buttons, no caption or resize hit areas (the parent window owns moving and sizing). Other windows (Ctrl+N) stay normal.
+bool BrowserFrameViewWin::IsOrbisEmbedded() const {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch("orbis-embedded") &&
+         ::GetParent(HWNDForView(this)) != nullptr;
+}
+
 int BrowserFrameViewWin::NonClientHitTest(const gfx::Point& point) {
+  const int component = NonClientHitTestUnlessEmbedded(point);
+  if (IsOrbisEmbedded() && component != HTNOWHERE && component != HTCLIENT &&
+      component != HTMENU && component != HTSYSMENU) {
+    return HTCLIENT;
+  }
+  return component;
+}
+
+int BrowserFrameViewWin::NonClientHitTestUnlessEmbedded(const gfx::Point& point) {
   int super_component = BrowserFrameView::NonClientHitTest(point);
   if (super_component != HTNOWHERE) {
     return super_component;
@@ -730,6 +747,11 @@ void BrowserFrameViewWin::LayoutTitleBar() {
 void BrowserFrameViewWin::LayoutCaptionButtons() {
   TRACE_EVENT0("views.frame", "BrowserFrameViewWin::LayoutCaptionButtons");
 
+  if (IsOrbisEmbedded()) {
+    caption_button_container_->SetVisible(false);
+    caption_button_container_->SetBounds(width(), WindowTopY(), 0, 0);
+    return;
+  }
   caption_button_container_->SetVisible(
       !browser_widget()->IsFullscreen() ||
       GetBrowserView()->IsWindowControlsOverlayEnabled());
