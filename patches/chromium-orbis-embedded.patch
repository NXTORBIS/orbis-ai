 #include "base/debug/gdi_debug_util_win.h"
 #include "base/functional/bind.h"
@@ -2342,6 +2343,16 @@ LRESULT HWNDMessageHandler::OnMouseActivate(UINT message,
 LRESULT HWNDMessageHandler::OnMouseRange(UINT message,
                                          WPARAM w_param,
                                          LPARAM l_param) {
+  // Orbis: an embedded browser window (a child of the Orbis app's window, made by
+  // --orbis-embedded) takes keyboard focus when it is clicked; the parent belongs to another
+  // process, so nothing else would give it the focus.
+  if ((message == WM_LBUTTONDOWN || message == WM_RBUTTONDOWN ||
+       message == WM_MBUTTONDOWN) &&
+      (::GetWindowLong(hwnd(), GWL_STYLE) & WS_CHILD) && ::GetParent(hwnd()) &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("orbis-embedded") &&
+      ::GetFocus() != hwnd()) {
+    ::SetFocus(hwnd());
+  }
   return HandleMouseEventInternal(message, w_param, l_param, true);
 }
 
