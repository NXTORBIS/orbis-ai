@@ -35,3 +35,41 @@
   display: block;
   width: 50%;
 }
+
+/* Orbis: the key hints along the foot of the prediction list. Measured from the
+ * Electron browser's own footer: a hairline above, muted text, and keycaps in the
+ * mono face at 10px. It is out of the accessibility tree because a screen reader
+ * announcing three shortcuts after every keystroke would be noise, not help —
+ * the bindings are reachable and documented elsewhere. */
+.orbis-foot {
+  display: flex;
+  align-items: center;
+  margin-top: 3px;
+  padding: 6px 10px 4px;
+  border-top: 1px solid var(--color-omnibox-results-background-hovered, rgba(255, 255, 255, 0.09));
+}
+
+.orbis-foot[hidden] {
+  display: none;
+}
+
+.orbis-keys {
+  overflow: hidden;
+  color: var(--color-omnibox-text-dimmed);
+  font-size: 11px;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.orbis-keys kbd {
+  margin: 0 3px 0 8px;
+  padding: 0 4px;
+  border: 1px solid var(--color-omnibox-results-background-hovered, rgba(255, 255, 255, 0.09));
+  border-radius: 4px;
+  font-family: var(--orbis-font-mono, ui-monospace, 'Cascadia Code', Consolas, monospace);
+  font-size: 10px;
+}
+
+.orbis-keys kbd:first-child {
+  margin-left: 0;
+}
