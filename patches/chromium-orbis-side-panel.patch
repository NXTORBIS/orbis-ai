+
+namespace {
+
+// The helper (the Orbis desktop app) tells the browser where it listens with
+// these switches. Absent switches mean the pages show an honest "Orbis is not
+// running" state; nothing is faked.
+constexpr char kHelperPortSwitch[] = "orbis-helper-port";
+constexpr char kHelperTokenSwitch[] = "orbis-helper-token";
+
+// The one port the pages may talk to, or empty when the helper is not running
+// or the switch is not a plain port number.
+std::string HelperPort() {
+  const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+  std::string port = cl->GetSwitchValueASCII(kHelperPortSwitch);
+  int value = 0;
+  if (!base::StringToInt(port, &value) || value < 1 || value > 65535) {
+    return std::string();
+  }
+  return base::NumberToString(value);
+}
+
+// The built-in Orbis pages, and only those, may read the helper connection.
+bool IsOrbisHost(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         (url.host() == chrome::kChromeUIOrbisHost ||
+          url.host() == chrome::kChromeUIOrbisNewTabHost ||
+          url.host() == chrome::kChromeUIOrbisSearchHost);
+}
+
+// The messages the built-in Orbis pages send to the browser. The handler exists
+// only inside these WebUIs, so no web page and no other chrome:// page can send
+// them; each message also checks that the top-level document is a page that is
+// allowed to ask. Values are never in an address or a resource anyone can
+// request.
+//   orbis.getHelper     the helper's port and token (all three pages)
+//   orbis.search        run a search as the address bar would, with the
+//                       person's default engine (new tab page only)
+//   orbis.mostVisited   the most visited sites (new tab page only)
+//   orbis.openPanel     show the native Orbis side panel of this window (new tab
+//                       page and search results, for the assistant orb)
+class OrbisPageHandler : public content::WebUIMessageHandler {
+ public:
+  OrbisPageHandler() = default;
+  OrbisPageHandler(const OrbisPageHandler&) = delete;
+  OrbisPageHandler& operator=(const OrbisPageHandler&) = delete;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "orbis.getHelper",
+        base::BindRepeating(&OrbisPageHandler::HandleGetHelper,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "orbis.search", base::BindRepeating(&OrbisPageHandler::HandleSearch,
+                                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "orbis.openPanel",
+        base::BindRepeating(&OrbisPageHandler::HandleOpenPanel,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "orbis.mostVisited",
+        base::BindRepeating(&OrbisPageHandler::HandleMostVisited,
+                            base::Unretained(this)));
+  }
+
+ private:
+  // The address of the page that is really showing. The tab's own address (GetLastCommittedURL of the contents) is the one the
+  // person sees, so the new tab page is chrome://newtab there; the frame's is chrome://orbis-newtab.
+  const GURL& PageUrl() {
+    return web_ui()->GetWebContents()->GetPrimaryMainFrame()->GetLastCommittedURL();
+  }
+
+  bool FromNewTabPage() {
+    const GURL& url = PageUrl();
+    return url.SchemeIs(content::kChromeUIScheme) &&
+           url.host() == chrome::kChromeUIOrbisNewTabHost;
+  }
+
+  void HandleGetHelper(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string& callback_id = args[0].GetString();
+    AllowJavascript();
+    const base::CommandLine* cl = base::CommandLine::ForCurrentProcess();
+    const std::string port = HelperPort();
+    if (!IsOrbisHost(PageUrl()) ||
+        port.empty() || !cl->HasSwitch(kHelperTokenSwitch)) {
+      ResolveJavascriptCallback(callback_id, base::Value());
+      return;
+    }
+    base::DictValue result;
+    int port_number = 0;
+    base::StringToInt(port, &port_number);
+    result.Set("port", port_number);
+    result.Set("token", cl->GetSwitchValueASCII(kHelperTokenSwitch));
+    ResolveJavascriptCallback(callback_id, result);
+  }
+
+  void HandleSearch(const base::ListValue& args) {
+    if (args.size() < 2 || !args[0].is_string() || !args[1].is_string()) {
+      return;
+    }
+    const std::string& callback_id = args[0].GetString();
+    AllowJavascript();
+    const std::string& text = args[1].GetString();
+    AutocompleteClassifier* classifier =
+        AutocompleteClassifierFactory::GetForProfile(
+            Profile::FromWebUI(web_ui()));
+    if (!FromNewTabPage() || !classifier || text.empty() ||
+        text.size() > 4096) {
+      RejectJavascriptCallback(callback_id, base::Value());
+      return;
+    }
+    AutocompleteMatch match;
+    GURL alternate;
+    classifier->Classify(base::UTF8ToUTF16(text), false, true,
+                         metrics::OmniboxEventProto::NTP, &match, &alternate);
+    if (!match.destination_url.is_valid()) {
+      RejectJavascriptCallback(callback_id, base::Value());
+      return;
+    }
+    content::NavigationController::LoadURLParams params(match.destination_url);
+    params.transition_type = ui::PAGE_TRANSITION_GENERATED;
+    web_ui()->GetWebContents()->GetController().LoadURLWithParams(params);
+    ResolveJavascriptCallback(callback_id, base::Value());
+  }
+
+  void HandleOpenPanel(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string& callback_id = args[0].GetString();
+    AllowJavascript();
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    const GURL& url = PageUrl();
+    if (!browser || !IsOrbisHost(url) ||
+        url.host() == chrome::kChromeUIOrbisHost) {
+      RejectJavascriptCallback(callback_id, base::Value());
+      return;
+    }
+    browser->GetFeatures().side_panel_ui()->Show(SidePanelEntryId::kOrbis);
+    ResolveJavascriptCallback(callback_id, base::Value());
+  }
+
+  void HandleMostVisited(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const std::string callback_id = args[0].GetString();
+    AllowJavascript();
+    scoped_refptr<history::TopSites> top_sites =
+        TopSitesFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+    if (!FromNewTabPage() || !top_sites) {
+      ResolveJavascriptCallback(callback_id, base::ListValue());
+      return;
+    }
+    top_sites->GetMostVisitedURLs(
+        base::BindOnce(&OrbisPageHandler::OnMostVisited,
+                       weak_factory_.GetWeakPtr(), callback_id));
+  }
+
+  void OnMostVisited(const std::string& callback_id,
+                     const history::MostVisitedURLList& sites) {
+    base::ListValue list;
+    for (const history::MostVisitedURL& site : sites) {
+      base::DictValue entry;
+      entry.Set("url", site.url.spec());
+      entry.Set("title", base::UTF16ToUTF8(site.title));
+      list.Append(std::move(entry));
+    }
+    ResolveJavascriptCallback(callback_id, list);
+  }
+
+  base::WeakPtrFactory<OrbisPageHandler> weak_factory_{this};
+};
+
+// The resources every built-in Orbis page shares: the library, the helper
+// client, the logo.
+void AddSharedResources(content::WebUIDataSource* source) {
+  source->AddResourcePath("helper.js", IDR_ORBIS_HELPER_JS);
+  source->AddResourcePath("orbis-tokens.css", IDR_ORBIS_TOKENS_CSS);
+  source->AddResourcePath("orbis.css", IDR_ORBIS_CSS);
+  source->AddResourcePath("orbis-components.js", IDR_ORBIS_COMPONENTS_JS);
+  source->AddResourcePath("orbis-ring.png", IDR_ORBIS_RING_PNG);
+}
+
+// The pages talk to the local helper over loopback HTTP, at the one port the
+// helper listens on and nowhere else; favicons come from the browser.
+void ApplyPolicy(content::WebUIDataSource* source) {
+  const std::string port = HelperPort();
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ConnectSrc,
+      port.empty() ? std::string("connect-src 'self';")
+                   : base::StrCat({"connect-src 'self' http://127.0.0.1:", port,
+                                   ";"}));
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src 'self' data: blob: https: http://127.0.0.1:* "
+      "chrome://favicon2;");
+}
+
+}  // namespace
+
+OrbisUIConfig::OrbisUIConfig()
+    : content::DefaultWebUIConfig<OrbisUI>(content::kChromeUIScheme,
+                                           chrome::kChromeUIOrbisHost) {}
+
+OrbisUI::OrbisUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUIOrbisHost);
+  source->AddResourcePath("", IDR_ORBIS_INDEX_HTML);
+  source->AddResourcePath("index.html", IDR_ORBIS_INDEX_HTML);
+  source->AddResourcePath("panel.html", IDR_ORBIS_INDEX_HTML);
+  source->AddResourcePath("panel.js", IDR_ORBIS_PANEL_JS);
+  source->AddResourcePath("panel.css", IDR_ORBIS_PANEL_CSS);
+  source->AddResourcePath("panel-adblock.js", IDR_ORBIS_PANEL_ADBLOCK_JS);
+  source->AddResourcePath("panel-notes.js", IDR_ORBIS_PANEL_NOTES_JS);
+  source->AddResourcePath("panel-tasks.js", IDR_ORBIS_PANEL_TASKS_JS);
+  source->AddResourcePath("panel-workflows.js", IDR_ORBIS_PANEL_WORKFLOWS_JS);
+  source->AddResourcePath("panel-galaxy.js", IDR_ORBIS_PANEL_GALAXY_JS);
+  source->AddResourcePath("panel-secrets.js", IDR_ORBIS_PANEL_SECRETS_JS);
+  source->AddResourcePath("sidebar.js", IDR_ORBIS_SIDEBAR_JS);
+  source->AddResourcePath("sidebar.css", IDR_ORBIS_SIDEBAR_CSS);
+  AddSharedResources(source);
+  web_ui->AddMessageHandler(std::make_unique<OrbisPageHandler>());
+  ApplyPolicy(source);
+}
+
+OrbisUI::~OrbisUI() = default;
+
+OrbisNewTabUIConfig::OrbisNewTabUIConfig()
+    : content::DefaultWebUIConfig<OrbisNewTabUI>(
+          content::kChromeUIScheme,
+          chrome::kChromeUIOrbisNewTabHost) {}
+
+OrbisNewTabUI::OrbisNewTabUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUIOrbisNewTabHost);
+  source->AddResourcePath("", IDR_ORBIS_NEWTAB_HTML);
+  source->AddResourcePath("index.html", IDR_ORBIS_NEWTAB_HTML);
+  source->AddResourcePath("newtab.js", IDR_ORBIS_NEWTAB_JS);
+  source->AddResourcePath("newtab.css", IDR_ORBIS_NEWTAB_CSS);
+  source->AddResourcePath("newtab-logic.js", IDR_ORBIS_NEWTAB_LOGIC_JS);
+  source->AddResourcePath("newtab-store.js", IDR_ORBIS_NEWTAB_STORE_JS);
+  source->AddResourcePath("orb.js", IDR_ORBIS_ORB_JS);
+  source->AddResourcePath("orb.css", IDR_ORBIS_ORB_CSS);
+  AddSharedResources(source);
+  web_ui->AddMessageHandler(std::make_unique<OrbisPageHandler>());
+  ApplyPolicy(source);
+}
+
+OrbisNewTabUI::~OrbisNewTabUI() = default;
+
+OrbisSearchUIConfig::OrbisSearchUIConfig()
+    : content::DefaultWebUIConfig<OrbisSearchUI>(
+          content::kChromeUIScheme,
+          chrome::kChromeUIOrbisSearchHost) {}
+
+OrbisSearchUI::OrbisSearchUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUIOrbisSearchHost);
+  source->AddResourcePath("", IDR_ORBIS_RESULTS_HTML);
+  source->AddResourcePath("index.html", IDR_ORBIS_RESULTS_HTML);
+  source->AddResourcePath("results.js", IDR_ORBIS_RESULTS_JS);
+  source->AddResourcePath("results.css", IDR_ORBIS_RESULTS_CSS);
+  source->AddResourcePath("orb.css", IDR_ORBIS_ORB_CSS);
+  AddSharedResources(source);
+  web_ui->AddMessageHandler(std::make_unique<OrbisPageHandler>());
+  ApplyPolicy(source);
+  // The viewer embeds a video from the site that hosts it.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::FrameSrc, "frame-src https:;");
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::MediaSrc,
+      "media-src 'self' https: blob:;");
+}
+
+OrbisSearchUI::~OrbisSearchUI() = default;
