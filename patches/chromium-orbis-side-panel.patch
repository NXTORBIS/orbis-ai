@@ -0,0 +1,324 @@
+// Copyright 2026 The Orbis Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/orbis/orbis_ui.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
