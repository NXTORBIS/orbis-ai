@@ -73,6 +73,27 @@ cr-searchbox-match:-webkit-any(:focus-within, [selected]) {
   z-index: 1;
 }
 
+/* Orbis: in the browser's own popup a section heading is a label, not a row. The
+ * stock header reserves 44px to match a result's height, which puts as much weight
+ * on "Recent searches" as on the searches themselves. Measured from the Electron
+ * browser: small mono capitals, widely tracked, sitting just above their group. */
+:host-context([is-top-chrome-searchbox_]) .header,
+:host([is-top-chrome-searchbox_]) .header {
+  height: auto;
+  padding-top: 7px;
+  padding-bottom: 3px;
+  padding-inline-start: 10px;
+}
+
+:host-context([is-top-chrome-searchbox_]) .header .text,
+:host([is-top-chrome-searchbox_]) .header .text {
+  font-family: var(--orbis-font-mono, ui-monospace, 'Cascadia Code', Consolas, monospace);
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
 @media (forced-colors: active) {
   cr-searchbox-match:-webkit-any(:hover, :focus-within, [selected]) {
     background-color: Highlight;
diff --git a/ui/webui/resources/cr_components/searchbox/searchbox_match.css b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
index 812e441a5a..e639176f21 100644
--- a/ui/webui/resources/cr_components/searchbox/searchbox_match.css
+++ b/ui/webui/resources/cr_components/searchbox/searchbox_match.css
@@ -77,6 +77,26 @@
   border-end-end-radius: 24px;
 }
 
+/* Orbis: in the browser's own omnibox popup a row is a row — inset the same
+ * amount on both sides and rounded the same amount at all four corners. The
+ * stock shape is square on the leading edge and a 24px capsule on the trailing
+ * one, which leaves the selected row looking like it is sliding off the panel.
+ * Geometry measured from the Electron browser's own list. */
+:host([is-top-chrome-searchbox_]) .container:not(.actions) {
+  border-radius: 8px;
+  margin-inline-end: 8px;
+  margin-inline-start: 8px;
+  min-height: 34px;
+  padding-inline-start: 10px;
+}
+
+/* The selected row is marked down its leading edge rather than filled. A block of
+ * colour across the whole row is the thing the Electron browser deliberately did
+ * not do: the accent says which row, the surface stays quiet enough to read. */
+:host([is-top-chrome-searchbox_]:is(:focus-visible, [selected])) .container:not(.actions) {
+  box-shadow: inset 2px 0 0 var(--color-omnibox-results-focus-indicator, currentColor);
+}
+
 :host-context([has-secondary-side]):host-context([can-show-secondary-side]) .container:not(.actions) {
   margin-inline-end: 0;
 }
