+/*
+ * The ring and the glow.
+ *
+ * The ring is drawn with an inset shadow rather than a border because a border would change the box and shift every
+ * icon inside the bar by a pixel as it appeared. The outer glow is the same accent at low strength, so the bar lifts
+ * off the toolbar instead of being outlined on it.
+ */
 :host(#location-bar:not(.no-focus-ring)):has(> readonly-omnibox:focus-within) {
-  box-shadow: inset 0 0 0 2px var(--orbis-accent);
+  box-shadow: inset 0 0 0 2px var(--orbis-accent),
+              0 0 0 4px color-mix(in srgb, var(--orbis-accent) 18%, transparent),
+              0 2px 14px color-mix(in srgb, var(--orbis-accent) 22%, transparent);
+}
+
+/*
+ * A light passing across the bar, once, as it is clicked into.
+ *
+ * It is drawn on a layer of its own so nothing in the bar moves: the text, the icons and the chips stay exactly where
+ * they were. `pointer-events: none` keeps it out of the way of every click, and it is only ever drawn while the bar
+ * holds focus, so it costs nothing the rest of the time.
+ */
+:host(#location-bar)::after {
+  border-radius: inherit;
+  content: '';
+  inset: 0;
+  opacity: 0;
+  pointer-events: none;
+  position: absolute;
+}
+
+:host(#location-bar):has(> readonly-omnibox:focus-within)::after {
+  animation: orbis-address-sweep 520ms cubic-bezier(0.2, 0, 0, 1) 1;
+  background: linear-gradient(
+      100deg,
+      transparent 20%,
+      color-mix(in srgb, var(--orbis-accent) 20%, transparent) 50%,
+      transparent 80%);
+}
+
+@keyframes orbis-address-sweep {
+  from { opacity: 0.9; transform: translateX(-60%); }
+  to { opacity: 0; transform: translateX(60%); }
+}
+
+/*
+ * Somebody who has asked for less movement gets the same bar without any of it: the fill and the ring are still there
+ * and still say the bar is focused, and only the travelling light and the easing are dropped.
+ */
+@media (prefers-reduced-motion: reduce) {
+  :host {
+    transition-duration: 0s;
+  }
+
+  :host(#location-bar):has(> readonly-omnibox:focus-within)::after {
+    animation: none;
+  }
 }
 
