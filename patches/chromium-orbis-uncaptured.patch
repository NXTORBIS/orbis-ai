+    int creation_flags = creation_flags_;
+    std::optional<bool> is_from_webstore =
+        extension_dict.FindBool(kIsFromWebstore);
+    if (is_from_webstore.value_or(false)) {
+      creation_flags |= Extension::FROM_WEBSTORE;
