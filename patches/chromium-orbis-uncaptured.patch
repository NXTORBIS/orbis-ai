+    if (!HandleMinProfileVersion(extension_dict, extension_id,
+                                 &unsupported_extensions)) {
+      continue;
+    }
+
+    if (!HandleDoNotInstallForEnterprise(extension_dict, extension_id,
+                                         &unsupported_extensions)) {
+      continue;
+    }
