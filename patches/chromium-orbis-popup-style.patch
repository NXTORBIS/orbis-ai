+  mixer[kColorMenuItemBackgroundHighlighted] = {dark_mode ? orbis::dark::kHover : orbis::light::kHover};
+  mixer[kColorMenuItemForegroundSelected] = {dark_mode ? orbis::dark::kText : orbis::light::kText};
+  mixer[kColorSeparator] = {dark_mode ? orbis::dark::kLine : orbis::light::kLine};
+  // Deeper than stock, because these sit over a page that is almost black.
+  mixer[kColorBubbleBorderShadowLarge] = {SetAlpha(kColorShadowBase, dark_mode ? 0x4D : 0x1A)};
