+  mixer[kColorBubbleBackground] = {orbis_popover};
+  mixer[kColorDialogBackground] = {orbis_popover};
+  mixer[kColorMenuBackground] = {orbis_popover};
+  mixer[kColorDropdownBackground] = {orbis_popover};
+  mixer[kColorTooltipBackground] = {orbis_popover};
+  mixer[kColorBubbleBorder] = {orbis_edge};
+  mixer[kColorMenuBorder] = {orbis_edge};
