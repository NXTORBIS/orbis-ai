+// Orbis: the Orbis palette for the whole browser UI, dark and light, generated from orbis-ui/tokens.json (orbis_tokens.h).
+// Every Views surface and every WebUI page that reads the Material "sys" tokens takes these colours.
+// Source-over composite of a translucent token colour on an opaque one (both 0xAARRGGBB).
+constexpr SkColor OrbisOver(SkColor fg, SkColor bg) {
+  const uint32_t a = fg >> 24;
+  auto ch = [&](int shift) { return static_cast<uint32_t>((((fg >> shift) & 0xFF) * a + ((bg >> shift) & 0xFF) * (255 - a)) / 255); };
+  return SkColorSetRGB(ch(16), ch(8), ch(0));
+}
+struct OrbisScheme {
+  SkColor bg, surface, surface2, surface3, text, muted, accent, accent_fill, line, hover, popover, on_accent;
+};
+constexpr OrbisScheme kOrbisDark = {orbis::dark::kBg,      orbis::dark::kSurface,  orbis::dark::kSurface2,
+                                    orbis::dark::kSurface3, orbis::dark::kText,     orbis::dark::kMuted,
+                                    orbis::dark::kAccent,  orbis::dark::kAccentFill, orbis::dark::kLine,
+                                    orbis::dark::kHover,   orbis::dark::kPopover,  orbis::dark::kBg};
+constexpr OrbisScheme kOrbisLight = {orbis::light::kBg,      orbis::light::kSurface,  orbis::light::kSurface2,
+                                     orbis::light::kSurface3, orbis::light::kText,     orbis::light::kMuted,
+                                     orbis::light::kAccent,  orbis::light::kAccentFill, orbis::light::kLine,
+                                     orbis::light::kHover,   orbis::light::kPopover,  SK_ColorWHITE};
+
+void AddOrbisSysColorOverrides(ColorMixer& mixer, bool dark) {
+  const OrbisScheme& s = dark ? kOrbisDark : kOrbisLight;
+  const SkColor kBg = s.bg, kPanel = s.surface, kPanel2 = s.surface2, kPanel3 = s.surface3;
+  const SkColor kText = s.text, kMuted = s.muted, kAccent = s.accent;
+  const SkColor kAccentContainer = OrbisOver(s.accent_fill, s.surface);
+
+  mixer[kColorSysPrimary] = {kAccent};
+  mixer[kColorSysOnPrimary] = {s.on_accent};
+  mixer[kColorSysPrimaryContainer] = {kAccentContainer};
+  mixer[kColorSysOnPrimaryContainer] = {kText};
+  mixer[kColorSysSecondaryContainer] = {kPanel2};
+  mixer[kColorSysOnSecondaryContainer] = {kText};
+  mixer[kColorSysOnSurface] = {kText};
+  mixer[kColorSysOnSurfaceVariant] = {kMuted};
+  mixer[kColorSysOutline] = {kPanel3};
+  mixer[kColorSysSurfaceVariant] = {kPanel2};
+
+  mixer[kColorSysSurface] = {kPanel};
+  mixer[kColorSysSurface1] = {kPanel};
+  mixer[kColorSysSurface2] = {kPanel};
+  mixer[kColorSysSurface3] = {kPanel2};
+  mixer[kColorSysSurface4] = {kPanel2};
+  mixer[kColorSysSurface5] = {kPanel3};
+  mixer[kColorSysOnSurfaceSecondary] = {kMuted};
+  mixer[kColorSysOnSurfaceSubtle] = {kMuted};
+  mixer[kColorSysOnSurfacePrimary] = {kAccent};
+  mixer[kColorSysTonalContainer] = {kAccentContainer};
+  mixer[kColorSysBaseTonalContainer] = {kAccentContainer};
+  mixer[kColorSysNeutralContainer] = {kPanel2};
+  mixer[kColorSysDivider] = {s.line};
+
+  mixer[kColorSysBase] = {kPanel};
+  mixer[kColorSysBaseContainer] = {kPanel};
+  mixer[kColorSysBaseContainerElevated] = {s.popover};
+  mixer[kColorSysHeader] = {kPanel};
+  mixer[kColorSysHeaderInactive] = {kPanel};
+  mixer[kColorSysHeaderContainer] = {kPanel2};
+  mixer[kColorSysHeaderContainerInactive] = {kPanel2};
+  mixer[kColorSysOnHeaderPrimary] = {kText};
+  mixer[kColorSysOnHeaderPrimaryInactive] = {kMuted};
+  mixer[kColorSysOnHeaderDivider] = {s.line};
+  mixer[kColorSysOnHeaderDividerInactive] = {s.line};
+  // Orbis: this is what a WebUI card is painted with (via kColorWebuiCardBackground).
+  // Upstream points it at surface1, which Orbis maps to the same panel colour the page
+  // itself uses, so settings, history and downloads drew cards that were exactly the
+  // colour of the page behind them. A card has to be the surface above the one it sits on.
+  mixer[kColorSysSurfaceSection] = {dark ? kPanel2 : s.popover};
+  mixer[kColorSysStateFocusRing] = {kAccent};
+  mixer[kColorTooltipBackground] = {s.popover};
+  mixer[kColorTooltipForeground] = {kText};
+  (void)kBg;
+}
 }  // namespace
 
