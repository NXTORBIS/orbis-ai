              key.user_color.has_value()) {
     AddThemedSysColorOverrides(mixer, key);
   }
+
+  // Orbis: always the Orbis palette (dark or light), on top of whatever else was chosen.
+  AddOrbisSysColorOverrides(mixer, dark_mode);
 }
 
