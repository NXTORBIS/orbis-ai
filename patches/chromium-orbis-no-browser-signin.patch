-                        &PrepopulatedEngineToTemplateURLData);
+  std::vector<std::unique_ptr<TemplateURLData>> engines = base::ToVector(
+      regional_prepopulated_engines, &PrepopulatedEngineToTemplateURLData);
+  // Orbis: first in the list, so it is the default (the first engine is the default).
+  engines.insert(engines.begin(), OrbisSearchEngine());
+  return engines;
 }
 
