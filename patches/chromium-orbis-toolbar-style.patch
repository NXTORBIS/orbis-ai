+
+/* Orbis: the WebUI toolbar parts (reload button, location bar) take the same Orbis look as the Views toolbar: every colour is the
+ * browser theme colour, which the colour mixer fills from orbis-ui/tokens.json (one token source), so light and dark both follow. */
+:root {
+  --orbis-bg: var(--color-toolbar);
+  --orbis-panel: var(--color-location-bar-background);
+  --orbis-panel-2: var(--color-location-bar-background-hovered);
+  --orbis-line: var(--color-location-bar-border);
+  --orbis-text: var(--color-omnibox-text);
+  --orbis-muted: var(--color-omnibox-text-dimmed);
+  --orbis-accent: var(--color-sys-primary);
+  --orbis-radius-control: 8px; /* tokens.json scale.radius.control */
+  --cr-focus-outline-color: var(--orbis-accent);
+}
