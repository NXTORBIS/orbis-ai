+
+#dragTitle {
+  overflow: hidden;
+  padding-inline: 2px;
+  text-overflow: ellipsis;
+  text-shadow:
+      0 0 1px var(--color-textfield-background),
+      0 0 1px var(--color-textfield-background),
+      0 0 2px var(--color-textfield-background),
+      0 0 2px var(--color-textfield-background);
+  white-space: nowrap;
+}
+
+/* Used for accessibility mark up only */
+#announcementDistraction {
+  position: absolute;
+  left: -10000px;
+}
